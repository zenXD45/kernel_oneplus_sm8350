# Architectures
CONFIG_ARCH_YUPIK=y

# NFC
CONFIG_OPLUS_NFC=y
CONFIG_NFC_ST21_I2C=y
# Touchpanel
CONFIG_TOUCHPANEL_ILITEK=y
CONFIG_TOUCHPANEL_ILITEK_ILITEK7807S=y

# WiFi
CONFIG_CNSS_QCA6490=n
CONFIG_CNSS_QCA6750=y

# --- MAX PERFORMANCE AND BATTERY TWEAKS ---
# Enable BBR TCP Congestion (Faster network / Low latency ping)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y

# Sched Tick Rate (Slightly smoother UI)
CONFIG_HZ_300=y

# Disable Heavy Debugging (Save CPU cycles)
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_IPC_LOGGING is not set

# Explicitly Disable KernelSU to prevent compilation errors
# CONFIG_KSU is not set
