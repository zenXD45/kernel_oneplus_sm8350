# Architectures
CONFIG_ARCH_YUPIK=y

# NFC
CONFIG_OPLUS_NFC=y
CONFIG_NFC_ST21_I2C=y

# Touchpanel
CONFIG_TOUCHPANEL_ILITEK=y
CONFIG_TOUCHPANEL_ILITEK_ILITEK7807S=y

# WiFi
CONFIG_CNSS_QCA6490=n
CONFIG_CNSS_QCA6750=y

# --- ULTRA SAFE PERFORMANCE TWEAKS ---
# Enable BBR TCP Congestion (Faster network / Low latency ping)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y

# Sched Tick Rate (Slightly smoother UI)
CONFIG_HZ_300=y

# Power Efficient Workqueues (Reduces heat on reballed CPU)
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# --- KernelSU (ReSukiSU) ---
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Hooking method: Manual (required for 5.4 — tracepoint hook needs 5.10+)
CONFIG_KSU_MANUAL_HOOK=y

# Auto-hook: lets KSU handle sys.c / read_write.c / input.c internally
# so those files do NOT need manual patches
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
